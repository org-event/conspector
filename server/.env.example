# Copy to .env and fill in. Do not commit .env.

HOST=127.0.0.1
PORT=8765

# Absolute or relative to process cwd; prefer absolute.
DATA_DIR=./data

ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=ru
ASR_VAD_FILTER=true
ASR_WARMUP=false

# OpenAI-compatible LLM (vLLM / Ollama / etc.)
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=local-llm
OLLAMA_API_KEY=
LLM_TIMEOUT_SEC=300
LLM_MAX_TOKENS=2048

MAX_UPLOAD_MB=500
