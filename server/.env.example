# Copy to .env and fill in. Do not commit .env.

HOST=127.0.0.1
PORT=8765

# Absolute or relative to process cwd; prefer absolute.
DATA_DIR=./data

# onnx-asr: gigaam-v3-e2e-rnnt (quality + punctuation) | gigaam-v3-e2e-ctc (faster)
ASR_MODEL=gigaam-v3-e2e-rnnt
ASR_DEVICE=cpu
# Leave empty for full precision; set int8 to save RAM
ASR_COMPUTE_TYPE=
ASR_LANGUAGE=ru
ASR_VAD_FILTER=true
ASR_WARMUP=false

# OpenAI-compatible LLM (vLLM / Ollama / etc.)
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=local-llm
OLLAMA_API_KEY=
LLM_TIMEOUT_SEC=300
LLM_MAX_TOKENS=2048

MAX_UPLOAD_MB=500
