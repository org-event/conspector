{
  "manifest_version": 3,
  "name": "Conspector",
  "version": "0.1.3",
  "permissions": ["storage", "tabs", "tabCapture", "activeTab", "offscreen", "scripting"],
  "host_permissions": ["http://127.0.0.1:*/*", "http://localhost:*/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
